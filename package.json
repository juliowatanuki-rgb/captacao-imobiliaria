{
  "name": "captacao-imobiliaria",
  "private": true,
  "version": "0.1.0",
  "description": "Sistema interno de inteligencia para captacao de imoveis - monitoramento diario de anuncios novos em imobiliarias de Praia Grande/SP",
  "workspaces": [
    "apps/*",
    "packages/*",
    "crawlers",
    "investigator"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "migrate": "npm run migrate -w @captacao/db",
    "seed:sites": "npm run seed:sites -w @captacao/db",
    "crawl:all": "npm run crawl:all -w @captacao/crawlers",
    "investigate:queue": "npm run investigate:queue -w @captacao/investigator"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "engines": {
    "node": ">=20"
  }
}
