# Copie para .env e preencha com os valores reais. Nunca commitar o .env de verdade.

# Connection string do Neon (postgres://user:senha@host/dbname?sslmode=require)
DATABASE_URL=

# Segredo usado para assinar os tokens JWT da API. Gerar um valor aleatorio longo.
JWT_SECRET=

# Origem do frontend, usada para o header CORS da API (ex: https://captacao.vercel.app)
WEB_ORIGIN=http://localhost:5173

# Chave da Gemini API, usada apenas pelo investigator/ (prova de conceito de
# localizacao de anuncios via IA). Em producao vem do secret GEMINI_API_KEY do
# GitHub Actions - so preencher aqui para rodar o investigator manualmente em
# ambiente local. NUNCA commitar uma chave real.
GEMINI_API_KEY=

# Usados apenas pelo sheets-sync/ (exportacao continua de anuncios pro Google
# Sheets). Em producao vem dos secrets GOOGLE_SHEETS_CREDENTIALS_JSON e
# GOOGLE_SHEETS_ID do GitHub Actions - ver README.md secao "Exportacao
# continua para o Google Sheets". So preencher aqui para rodar localmente.
# NUNCA commitar uma chave real.
GOOGLE_SHEETS_CREDENTIALS_JSON=
GOOGLE_SHEETS_ID=

# Usado apenas pela API (apps/api/api/crawl/trigger.ts) para o botao
# "Sincronizar agora" do painel disparar o workflow crawl.yml no GitHub
# Actions. Personal Access Token (classic ou fine-grained) com permissao de
# "Actions: write" no repositorio. Configurar como env var do projeto na
# Vercel - ver README.md secao "Sincronizacao manual". Nao precisa preencher
# aqui pra rodar o painel localmente sem esse botao.
GITHUB_DISPATCH_TOKEN=
